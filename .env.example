# yarr configuration. Copy this file to .env for local testing:
#   cp .env.example .env
# Then edit MUSIC_HOST_PATH to point at a scratch music folder.

# Host port to reach the UI. 7734 avoids the common *arr ports:
# Radarr 7878, Sonarr 8989, Lidarr 8686, Readarr 8787, Prowlarr 9696,
# Bazarr 6767.
HOST_PORT=7734

# Absolute path on the host to your Plex music library.
# yarr writes Artist/Album/Track - Title.mp3 folders under it.
MUSIC_HOST_PATH=/path/to/your/plex/music

# MP3 bitrate (kbps).
AUDIO_QUALITY=192

# Optional: cookies.txt from a logged-in browser to avoid YouTube 403s.
# The compose file always mounts a cookies file read-only at /cookies.txt.
# By default it uses the empty placeholder cookies.txt shipped with this repo,
# which is harmless. To enable real login cookies, set COOKIES_HOST_PATH to your
# exported cookies.txt. The app continues without cookies if the file is
# missing or invalid, so this can be left unset.
# COOKIES_HOST_PATH=/path/to/cookies.txt

# Optional: the path inside the container where the app reads cookies.txt.
# Defaults to /cookies.txt and normally does not need to change.
# YTDLP_COOKIEFILE=/cookies.txt

# Optional: comma-separated yt-dlp YouTube player clients. Leave empty to use the
# yt-dlp defaults. Example: android,tv,web_embedded
# YTDLP_PLAYER_CLIENTS=

# Run the container as this host uid/gid so new files are owned by you.
# Find yours with:  id -u && id -g
PUID=1000
PGID=1000

# Timezone for logs.
TZ=America/New_York
